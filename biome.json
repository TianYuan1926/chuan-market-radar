{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/generated"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "preset": "recommended"
      },
      "security": {
        "preset": "recommended"
      }
    }
  }
}
